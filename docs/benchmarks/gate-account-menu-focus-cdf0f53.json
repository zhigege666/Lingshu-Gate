  "proven_defect": {
    "trigger": "Escape before the three queued dropdown autofocus frames have run.",
    "sequence": [
      "The Console capture listener closes the menu and focuses its trigger.",
      "The stale dropdown autofocus subsequently calls the Menu focus API while the trigger reports aria-expanded=false.",
      "The visible OpenAPI menu item becomes active; after its menu unmounts, activeElement is BODY."
    ],
    "locked_dependency_evidence": {
      "dropdown": "@rc-component/dropdown@1.0.3 es/hooks/useAccessibility.js schedules raf(focusMenu, 3) without cancellation in its close cleanup.",
      "popup_cache": "@rc-component/trigger PopupContent memoizes children while closing, so a boolean open prop on the popup can remain true."
    },
    "limits": [
      "The unmodified original two cases passed all 20 local natural observations. This does not invalidate the prior real CI failure.",
      "The controlled local experiment establishes a defect and a before/after regression, but cannot prove that it uniquely caused the original hosted CI failure without that original trace."
    ]
  },
