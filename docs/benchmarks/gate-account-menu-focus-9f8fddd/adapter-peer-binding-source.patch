@@ -6,0 +7 @@ import hashlib
+import importlib.util
@@ -8,0 +10 @@ import os
+import py_compile
@@ -166,0 +169,4 @@ class OwnedBoundaryTests(unittest.TestCase):
+        peer = source / "scripts/e2e/http_peer.py"
+        peer.parent.mkdir(parents=True)
