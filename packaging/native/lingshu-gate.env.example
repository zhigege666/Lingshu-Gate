# Copy the values you need into your process environment before running Lingshu Gate.
# The start script defaults these paths to writable directories inside the bundle.

LINGSHU_GATE_HOST=127.0.0.1
LINGSHU_GATE_PORT=8000
LINGSHU_GATE_LOG_LEVEL=INFO
LINGSHU_GATE_AUTH_ENABLED=true
LINGSHU_GATE_RUNTIME_ROLE=local
# Comma-separated exact browser origins for /mcp. Empty permits only loopback
# origins on LINGSHU_GATE_PORT; non-browser requests normally omit Origin.
LINGSHU_GATE_MCP_ALLOWED_ORIGINS=
