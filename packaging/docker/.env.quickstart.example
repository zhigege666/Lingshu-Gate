# This file is rendered for the downloaded release; no source checkout is needed.
LINGSHU_GATE_IMAGE=ghcr.io/zhigege666/lingshu-gate:@VERSION@
LINGSHU_GATE_PULL_POLICY=missing
LINGSHU_GATE_HTTP_PORT=8000
# If you change the port, set its exact loopback browser origin here as well.
# Example for port 18000: http://127.0.0.1:18000
LINGSHU_GATE_MCP_ALLOWED_ORIGINS=
