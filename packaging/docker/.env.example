# This release tag is usable for evaluation. Pin the published sha256 digest for production.
LINGSHU_GATE_IMAGE=ghcr.io/zhigege666/lingshu-gate:@VERSION@
LINGSHU_GATE_PULL_POLICY=always
LINGSHU_GATE_BIND_ADDRESS=127.0.0.1
LINGSHU_GATE_HTTP_PORT=8000
LINGSHU_GATE_TRUSTED_PROXY_IPS=127.0.0.1
# Set exact comma-separated browser origins when a reverse proxy exposes /mcp.
# Empty permits only loopback origins on the configured service port.
LINGSHU_GATE_MCP_ALLOWED_ORIGINS=
LINGSHU_GATE_WORKSPACE_ROOT=/absolute/path/to/lingshu-gate/workspace
LINGSHU_GATE_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
LINGSHU_GATE_BOOTSTRAP_PASSWORD_FILE=/absolute/path/to/lingshu-gate/bootstrap-password
